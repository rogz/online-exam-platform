# Copy to .env (never commit .env). Used by docker-compose.yml on your own server.
DOMAIN=quiz.abnjworks.com
POSTGRES_PASSWORD=change-me-to-a-long-random-password
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-too
SITE_NAME="Exam Wizard"
TIME_ZONE=Asia/Manila
# Optional: automatic PayPal checkout (developer.paypal.com → Apps & Credentials). Add PAYPAL_ENV=sandbox to test with fake money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: email for "Forgot your password?" (see README, "Email"). For Gmail use an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
